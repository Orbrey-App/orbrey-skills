{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__orbrey__.*(delete|merge|adjust).*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/confirm-destructive.mjs"],
            "timeout": 10,
            "statusMessage": "Reviewing destructive Orbrey call..."
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate-order.mjs"],
            "timeout": 10,
            "statusMessage": "Checking grocery order safety gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__orbrey__recipes_create",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/suggest-meal-slot.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
