{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(recipes_delete_items|lists_delete_lists|tasks_delete_items|tasks_delete_occurrences|calendar_delete_events|grocery_delete_items|grocery_delete_lists|pantry_delete_items|grocery_merge|pantry_merge)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/confirm-destructive.mjs"],
            "timeout": 10,
            "statusMessage": "Reviewing destructive Orbrey call..."
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__click",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate-order.mjs"],
            "timeout": 10,
            "statusMessage": "Checking grocery order safety gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__recipes_create$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/suggest-meal-slot.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
